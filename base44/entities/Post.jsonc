{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Post text content"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Recipe",
        "Resource Tip",
        "Community News",
        "Event",
        "Question",
        "Success Story",
        "General"
      ],
      "default": "General"
    },
    "county": {
      "type": "string",
      "default": "Genesee"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "content",
    "author_email"
  ],
  "x-base44-rls": {
    "public_read": true
  }
}